# Private server configuration; all values intentionally empty.
PAYMENT_CONFIG=/etc/shiny-payments/config.json
PAYMENT_CSRF_SECRET=
# Only used if the bridge/New API integration is explicitly switched to MD5.
PAYMENT_EPAY_SECRET=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
LIANLIAN_API_KEY=
# Base64-encoded API Secret; webhook secret is a DIFFERENT, literal whsec_ value.
LIANLIAN_API_SECRET=
LIANLIAN_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
