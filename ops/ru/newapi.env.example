# Copy to /etc/shiny/ru-newapi.env, readable only by root/service owner.
# Replace placeholders; never use the main site's DB/session secret/Redis DB.
HOST=127.0.0.1
PORT=3001
SQL_DSN=postgres://shiny_ru:REPLACE_DATABASE_PASSWORD@127.0.0.1:5432/shiny_ru?sslmode=disable
# Omit LOG_SQL_DSN to keep RU logs in the same separate RU database.
# Do not point it at the main site's log database.
SQL_MAX_OPEN_CONNS=30
SQL_MAX_IDLE_CONNS=5
SQL_MAX_LIFETIME=300
SESSION_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://ru.shinyapi.com
TRUSTED_PROXIES=127.0.0.1
TRUSTED_REDIRECT_DOMAINS=ru.shinyapi.com
DEFAULT_LANGUAGE=en
# ru is supported by the web console. Backend email language currently supports
# en / zh-CN / zh-TW; do not silently claim that RU transactional mail is ready.
MEMORY_CACHE_ENABLED=true
# Redis is optional for one RU process. If enabled, use an independent instance
# or explicitly verified isolated keyspace/ACL, never the main Redis config.
GENERATE_DEFAULT_TOKEN=false
NODE_TYPE=master
# Native hosted payments: live for this RU instance. A sandbox instance must use
# PAYMENTS_ENVIRONMENT=test with its own test database, domain and credentials.
PAYMENTS_ENVIRONMENT=live
# Native provider selection for NEW orders. Start closed, then choose an approved
# combination such as cispay,nowpayments. Merchant settings are still required.
# Removing a provider does not interrupt enabled callbacks for existing orders.
# Legacy Epay/Stripe/Creem/Waffo use their own settings, independent of this list.
PAYMENTS_PROVIDERS=none
# Leave FRONTEND_BASE_URL unset: the RU instance serves its own console assets.
