[Unit]
Description=Shiny portal content and publishing service
After=network-online.target relay-native-new-api.service
Wants=network-online.target

[Service]
User=shiny-portal
Group=shiny-portal
WorkingDirectory=/opt/shiny-portal/current/backend
Environment=PORTAL_DATA_DIR=/var/lib/shiny-portal
Environment=PORTAL_SNAPSHOT_DIR=/var/cache/shiny-portal
Environment=PORTAL_SEED_PATH=/opt/shiny-portal/current/backend/seed.json
Environment=PORTAL_ORIGIN=https://shinyapi.com
Environment=PORTAL_NEWAPI_URL=http://127.0.0.1:3000
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/shiny-portal/venv/bin/gunicorn --workers 1 --threads 6 --bind 127.0.0.1:18441 --timeout 45 --access-logfile - --error-logfile - --access-logformat "%%(m)s %%(U)s %%(s)s %%(L)s" wsgi:application
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/shiny-portal /var/cache/shiny-portal
UMask=0077
MemoryMax=256M
TasksMax=64
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
